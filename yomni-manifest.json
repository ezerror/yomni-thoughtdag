{
  "title": "ThoughtDAG",
  "author": "Modera contributors and Xia Chen",
  "category": "productivity",
  "icon": "box",
  "locales": {
    "zh-CN": {
      "name": "思维画布",
      "description": "在 Yomni 工作台中将对话组织为可编辑的思维图。"
    }
  },
  "permissions": [
    "yomni.history.read",
    "yomni.storage.read",
    "yomni.storage.write",
    "yomni.models.generate"
  ],
  "extensions": [
    "yomni.ui.workbench"
  ],
  "frontends": {
    "workbench": {
      "root": "dist/ui",
      "entry": "index.html"
    }
  },
  "consumes": {
    "history": {
      "contract": "yomni.conversations.history",
      "apiVersion": 1,
      "autoBind": true
    }
  },
  "declarations": {
    "provides": {
      "ui": [
        {
          "id": "yomni.thoughtdag.workbench",
          "slot": "yomni.ui.workbench",
          "description": "ThoughtDAG canvas and conversation workbench"
        }
      ]
    },
    "consumes": {
      "access": [
        {
          "id": "yomni.app-conversations.history.list",
          "reason": "Import conversations from the current Yomni project"
        },
        {
          "id": "yomni.app-conversations.history.snapshot",
          "reason": "Read native conversation responses and import messages"
        }
      ]
    }
  }
}
