{
  "name": "@yomni/plugin-thoughtdag",
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "thoughtdagUpstream": {
    "repository": "https://github.com/chenxiachan/thoughtdag",
    "commit": "47ab0937ac5b67d6da98a4aea84f3e9e884d94cc",
    "version": "0.5.17",
    "base": "1d7676bbee9a583e3381f79443da64cad161350f"
  },
  "files": [
    "yomni-manifest.json",
    "dist",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && npm --prefix upstream run typecheck",
    "build": "npm --prefix upstream ci --ignore-scripts --no-audit --no-fund && npm --prefix upstream run build:host && node scripts/build-host.mjs && yomni-plugin-build .",
    "pack": "yomni-plugin pack .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "node tests/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@yomni/contracts": "file:vendor/yomni-devkit/yomni-contracts-0.1.0.tgz",
    "@yomni/plugin-build": "file:vendor/yomni-devkit/yomni-plugin-build-0.1.0.tgz",
    "@yomni/plugin-sdk": "file:vendor/yomni-devkit/yomni-plugin-sdk-0.1.0.tgz",
    "@yomni/ui": "file:vendor/yomni-devkit/yomni-ui-0.1.0.tgz",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3"
  },
  "description": "ThoughtDAG canvas for Yomni native conversations",
  "yomni": {
    "id": "yomni.thoughtdag",
    "apiVersion": 1,
    "runtime": "node",
    "manifest": "./yomni-manifest.json"
  },
  "exports": "./dist/index.cjs"
}
