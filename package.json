{
  "name": "@anypal-plugin/thoughtdag",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "thoughtdagUpstream": {
    "repository": "https://github.com/chenxiachan/thoughtdag",
    "commit": "47ab0937ac5b67d6da98a4aea84f3e9e884d94cc",
    "version": "0.5.17",
    "base": "1d7676bbee9a583e3381f79443da64cad161350f"
  },
  "files": [
    "pal-manifest.json",
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && npm --prefix upstream exec -- tsc -b",
    "build": "npm --prefix upstream ci --ignore-scripts --no-audit --no-fund && npm --prefix upstream run build -- --base=./ --outDir=../dist/ui --emptyOutDir && pal-plugin-build .",
    "pack": "pal-plugin pack .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "node tests/smoke.mjs"
  },
  "devDependencies": {
    "@anypal/contracts": "^0.1.0",
    "@anypal/plugin-build": "^0.1.0",
    "@anypal/plugin-sdk": "^0.1.0",
    "@anypal/ui": "^0.1.0",
    "typescript": "~5.9.3",
    "@types/node": "^24.10.1"
  },
  "dependencies": {},
  "description": "ThoughtDAG canvas for PAL native conversations",
  "pal": {
    "id": "pal.thoughtdag",
    "apiVersion": 1,
    "runtime": "node",
    "manifest": "./pal-manifest.json"
  },
  "exports": "./dist/index.cjs"
}
